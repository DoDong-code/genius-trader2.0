/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

/* 实验功能关闭时隐藏「分析」tab：用 class 控制 display，不增删 DOM 节点，
   因此切 tab（只改 selected）不会改变可见 tab 数量，也不会触发图标重载闪烁 */
.tab-bar-item.is-hidden {
  display: none;
}

.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  position: absolute;
  left: 0;
  top: 0;
  width: 48rpx;
  height: 48rpx;
}

/* 普通态与选中态两张图标常驻 DOM，仅切换透明度，避免选中切换时 SVG 重新加载造成闪烁 */
.tab-icon-active {
  opacity: 0;
}

.tab-bar-item.active .tab-icon-active {
  opacity: 1;
}

.tab-bar-item.active .tab-icon-normal {
  opacity: 0;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1;
  margin-top: 6rpx;
}
