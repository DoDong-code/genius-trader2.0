<!-- pages/profile/profile.wxml -->
<view class="container" style="padding-top: {{statusBarHeight + navBarHeight}}px; padding-bottom: calc(80rpx + env(safe-area-inset-bottom));">

  <!-- 顶部返回导航 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
    <view class="topbar-content" style="height: {{navBarHeight}}px;">
      <view class="back-btn" bindtap="goBack">‹</view>
      <text class="title">账号信息</text>
    </view>
  </view>

  <!-- 头像 -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{userInfo.avatarUrl || '/images/default_avatar.png'}}" mode="aspectFill" />
      <view class="avatar-edit-hint">点击修改头像</view>
    </button>
  </view>

  <!-- 昵称 -->
  <view class="field">
    <text class="field-label">昵称</text>
    <input class="field-input" type="nickname" value="{{userInfo.nickName}}" bindinput="onInputNickname" bindblur="onInputNickname" placeholder="输入昵称" />
  </view>

  <!-- 账号状态 -->
  <view class="status-row" wx:if="{{authUser}}">
    <text class="status-label">登录账号</text>
    <text class="status-value">{{authUser.email}}</text>
  </view>
  <view class="status-row" wx:else>
    <text class="status-label">账号状态</text>
    <text class="status-value">游客模式（未登录，数据仅存本机）</text>
  </view>

  <!-- 上次同步时间（仅正式用户可见） -->
  <view class="status-row" wx:if="{{authUser}}">
    <text class="status-label">上次同步</text>
    <text class="status-value">{{lastSyncTime || '尚未同步'}}</text>
  </view>

  <!-- 登录 / 同步 / 恢复 / 退出 -->
  <view class="actions" style="padding-top: 16rpx;" wx:if="{{authUser}}">
    <button class="btn btn-primary" bindtap="onSyncNow">立即同步</button>
  </view>
  <view class="actions" style="padding-top: 12rpx;">
    <button wx:if="{{!authUser}}" class="btn btn-secondary" bindtap="goLogin">登录 / 注册</button>
    <button wx:if="{{authUser}}" class="btn btn-secondary" bindtap="onRestoreLocal">恢复本地</button>
    <button wx:if="{{authUser}}" class="btn btn-danger" bindtap="onLogout">退出登录</button>
  </view>

  <!-- 备份与恢复（仅正式用户可见；P1：删除「立即备份」，备份统一在设置页导出/账号页列表管理） -->
  <view class="backup-section" style="padding-top: 24rpx;" wx:if="{{authUser}}">
    <view style="display:flex; align-items:center; justify-content:space-between; margin-bottom: 12rpx;">
      <text class="field-label">备份与恢复（最近 {{backups.length}} 次）</text>
    </view>
    <view wx:if="{{backups.length === 0}}" class="status-row">
      <text class="status-value">暂无备份</text>
    </view>
    <view wx:for="{{backups}}" wx:key="id" class="status-row" style="justify-content: space-between; border-bottom: 1rpx solid rgba(0,0,0,0.04); padding: 12rpx 0;">
      <view style="display:flex; flex-direction:column; gap: 4rpx; min-width:0; flex:1;">
        <text class="status-value">{{item.created_at}}</text>
        <text class="status-label">{{item.account_count}} 个账户 · {{item.reason === 'logout' ? '退出前' : item.reason === 'manual' ? '手动备份' : item.reason}}</text>
      </view>
      <view style="display:flex; gap: 28rpx; flex-shrink: 0; align-items: center;">
        <button class="text-link-btn" data-id="{{item.id}}" bindtap="onRestoreBackup">恢复</button>
        <button class="text-link-btn danger" data-id="{{item.id}}" bindtap="onDeleteBackup">删除</button>
      </view>
    </view>
  </view>

</view>
