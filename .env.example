# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI, DeepSeek, Kimi, and Claude API Keys
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
KIMI_API_KEY="YOUR_KIMI_API_KEY"
CLAUDE_API_KEY="YOUR_CLAUDE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# 第三方凭证加密密钥（必填，生产环境必须配置；未配置时使用开发默认密钥并输出警告）
SOURCE_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_SECRET"

# 养基宝接口（可选，默认官方地址）
YJB_BASE_URL="http://browser-plug-api.yangjibao.com"
# YJB_SECRET 为养基宝官方公开的固定签名密钥（多个开源实现中一致），无需配置即使用官方默认值
# YJB_SECRET=""

# 小倍养基接口（可选，默认官方地址）
XBYJ_BASE_URL="https://api.xiaobeiyangji.com"
XBYJ_VERSION="3.5.7.0"
