# ============================================================
# Genius Trader 环境变量（CloudBase 云托管 / 本地开发通用）
# 不要把真实密钥提交到 GitHub；全部通过 CloudBase 环境变量或密钥配置。
# ============================================================

# ---- 数据库（必填，云托管生产环境）----
# 设置 DATABASE_URL 即启用 PostgreSQL 模式（dbAsync）；未设置则回退本地 SQLite（仅开发/缓存）。
# 例：postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=""

# ---- 凭证加密密钥（必填，生产环境）----
# 重要：若从 Render 迁移，必须沿用 Render 为 SOURCE_SECRET_KEY 生成的「同一值」，
# 否则历史 source_credentials（养基宝/小倍 Token）将无法解密。
# 新部署（无历史数据）请生成一个随机强密钥。
# 未配置时会使用开发默认密钥并输出警告（仅限本地开发）。
SOURCE_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_SECRET"

# ---- AI 服务 API Key（按需配置；未配置时对应模型不可用，不影响其他功能）----
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
KIMI_API_KEY="YOUR_KIMI_API_KEY"
CLAUDE_API_KEY="YOUR_CLAUDE_API_KEY"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ---- 应用公网地址（CloudBase HTTPS 入口；用于自引用链接等）----
APP_URL="MY_APP_URL"

# ---- 养基宝接口（默认官方地址，HTTP）----
# 保持 HTTP 不变，除非在 CloudBase 实测 HTTPS 可用；小程序不直接访问该地址。
YJB_BASE_URL="http://browser-plug-api.yangjibao.com"
# YJB_SECRET 为养基宝公开固定签名密钥，无需配置即使用官方默认值
# YJB_SECRET=""

# ---- 小倍养基接口（默认官方地址，HTTPS）----
XBYJ_BASE_URL="https://api.xiaobeiyangji.com"
XBYJ_VERSION="3.5.7.0"

# ---- 可选：本地/容器内部覆盖 ----
# FUND_DB_PATH="./server/data/portfolio.sqlite"
# FUND_API_PORT="3000"
# PORT="3000"
