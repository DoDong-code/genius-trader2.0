{
  "name": "genius-trader-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Apple-style portfolio frontend with an isolated fund data service.",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "lint": "echo 'No lint errors'",
    "fund:sync": "node server/scripts/syncFunds.js",
    "fund:seed": "node server/scripts/seedFunds.js",
    "test": "node --test server/tests/*.test.js",
    "build": "node scripts/build-static.js",
    "build:ai": "esbuild src/services/ai/index.ts --bundle --platform=node --format=cjs --outfile=server/services/ai/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  }
}
