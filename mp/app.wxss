/* app.wxss */

page {
  --bg-primary: #f5f5f7;
  --card-dark: #ffffff;
  --card-dark-secondary: #f5f5f7;
  --border-color: rgba(0, 0, 0, 0.06);
  --border-color-faint: rgba(0, 0, 0, 0.03);
  
  --brand-blue: #0071e3;
  --brand-green: #34a853;
  --brand-red: #ff3b30;
  --brand-gold: #ffd60a;
  
  --text-primary: #1d1d1f;
  --text-secondary: #86868b;
  --text-tertiary: #c7c7cc;
  
  --border-radius-sm: 12rpx;
  --border-radius-md: 20rpx;
  --border-radius-lg: 32rpx;

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

view, text, scroll-view, input, button, picker {
  box-sizing: border-box;
}

.container {
  padding: 0 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--bg-primary);
}

/* Card layout wrapper */
.card {
  background-color: var(--card-dark);
  border-radius: var(--border-radius-md);
  border: 1px solid var(--border-color);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

/* Base Headings & Titles */
.eyebrow {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--brand-blue);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  display: block;
}

/* Buttons styling with absolute precision */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx; /* Pill buttons strictly matching web! */
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 36rpx;
  transition: opacity 0.15s ease, transform 0.1s ease;
  line-height: 1.4;
  border: none;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background-color: var(--brand-blue);
  color: #ffffff;
}

.btn-secondary {
  background-color: #e8e8ed;
  color: var(--text-primary);
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.btn-danger {
  background-color: rgba(255, 59, 48, 0.1);
  color: var(--brand-red);
  border: 1px solid rgba(255, 59, 48, 0.2);
}

/* Indicators and Positive/Negative Rates */
.positive {
  color: var(--brand-red) !important; /* Chinese stock market standard: RED for UP */
}

.negative {
  color: var(--brand-green) !important; /* Chinese stock market standard: GREEN for DOWN */
}

/* Forms layout */
.form-group {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background-color: #f5f5f7;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 80rpx;
  width: 100%;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.picker-selector {
  background-color: #f5f5f7;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-sm);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-selector::after {
  content: "▾";
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-left: 12rpx;
}

/* Empty placeholder container */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* Modal layout elements */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background-color: #ffffff;
  border-top-left-radius: var(--border-radius-lg);
  border-top-right-radius: var(--border-radius-lg);
  width: 100%;
  max-height: 90vh;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  border-top: 1px solid rgba(0, 0, 0, 0.05);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 750;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  text-align: center;
}
