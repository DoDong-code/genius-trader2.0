/* pages/portfolio/portfolio.wxss */

/* Unified Web-Style Brand Navigation Header */
.web-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 20rpx;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.brand-pill {
  background-color: #1d1d1f;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  letter-spacing: -0.5rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-nav {
  display: flex;
  gap: 8rpx;
}

.nav-item {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #86868b;
  transition: all 0.15s ease;
}

.nav-item.active {
  background-color: #e8e8ed;
  color: #1d1d1f;
  font-weight: 700;
}

/* User & Clock Ticking Row */
.user-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.user-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #e8e8ed;
  padding: 6rpx 18rpx 6rpx 8rpx;
  border-radius: 999rpx;
}

.avatar-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #1d1d1f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.status-clock {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.clock-time {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d1d1f;
  font-family: monospace;
}

.active-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #34a853;
  box-shadow: 0 0 8rpx rgba(52, 168, 83, 0.4);
}

.clock-date {
  font-size: 22rpx;
  color: #86868b;
}

.refresh-circle-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.08);
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
  transition: transform 0.15s ease;
}

.refresh-circle-btn:active {
  transform: scale(0.92);
  background-color: #f5f5f7;
}

.refresh-arrow {
  font-size: 24rpx;
  color: #1d1d1f;
  font-weight: bold;
}

/* Portfolio Summary Header Card */
.portfolio-summary-card {
  background-color: #ffffff;
  border-radius: var(--border-radius-lg);
  padding: 38rpx;
  border: 1px solid var(--border-color);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 28rpx;
}

.card-columns {
  display: flex;
  justify-content: space-between;
}

.card-column-left {
  display: flex;
  flex-direction: column;
}

.card-column-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.card-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.card-value-large {
  font-size: 52rpx;
  font-weight: 850;
  color: var(--text-primary);
  letter-spacing: -1.5rpx;
  font-variant-numeric: tabular-nums;
}

.card-value-large-today {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.card-pct {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* Portfolio list action row toolbar */
.portfolio-action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.action-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.items-count {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.list-title {
  font-size: 30rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.action-right {
  display: flex;
  gap: 12rpx;
}

.customize-btn, .add-fund-btn {
  font-size: 20rpx !important;
  padding: 10rpx 24rpx !important;
  min-height: 48rpx !important;
}

/* Horizontal Category Pills Slider Selector */
.category-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 8rpx 0 24rpx;
  margin-bottom: 20rpx;
  width: 100%;
}

.category-pill {
  display: inline-block;
  background-color: #e8e8ed;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
  border: 1px solid rgba(0, 0, 0, 0.02);
  transition: all 0.15s ease;
}

.category-pill.active {
  background-color: var(--brand-blue);
  color: #ffffff;
  font-weight: 700;
  border-color: var(--brand-blue);
}

/* Holdings 4-Column Grid Table Headers */
.holdings-table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 12rpx;
}

.col-head {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.sort-icon {
  font-size: 16rpx;
  color: var(--brand-blue);
}

.col-name {
  flex: 1.8;
  text-align: left;
}

.col-today {
  flex: 1.1;
  text-align: right;
  justify-content: flex-end;
}

.col-holding {
  flex: 1.1;
  text-align: right;
  justify-content: flex-end;
}

.col-amount {
  flex: 1.1;
  text-align: right;
  justify-content: flex-end;
}

/* Holdings 4-Column List Box */
.holdings-list-box {
  background-color: var(--card-dark);
  border-radius: var(--border-radius-md);
  border: 1px solid var(--border-color);
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.holding-row-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1px solid var(--border-color-faint);
  transition: background-color 0.15s ease;
}

.holding-row-box:active {
  background-color: rgba(0, 0, 0, 0.02);
}

.holding-row-box:last-child {
  border-bottom: 0;
}

.col-body {
  display: flex;
  flex-direction: column;
}

.fund-name-lbl {
  font-size: 26rpx;
  font-weight: 750;
  color: var(--text-primary);
  line-height: 1.35;
  max-width: 250rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-badge-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.estimate-badge {
  font-size: 14rpx;
  font-weight: 700;
  color: #86868b;
  background-color: #e8e8ed;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.fund-code-lbl {
  font-size: 18rpx;
  font-family: monospace;
  color: var(--text-secondary);
}

.today-val-lbl, .holding-profit-val, .holding-amount-lbl {
  font-size: 26rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.holding-amount-lbl {
  color: var(--text-primary);
}

.today-pct-lbl, .holding-pct-lbl, .holding-weight-lbl {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

/* Autocomplete lookup status helper styling */
.lookup-status {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  display: block;
  line-height: 1.3;
}

.lookup-success-text {
  color: var(--brand-green) !important;
  font-weight: 600;
}
