<!-- pages/portfolio/portfolio.wxml -->
<view class="container">
  
  <!-- Web-style Unified Navigation Header Bar -->
  <view class="web-header">
    <view class="brand-pill">Genius trader</view>
    <view class="header-nav">
      <view class="nav-item" bindtap="navigateToOverview">总览</view>
      <view class="nav-item active">持仓</view>
    </view>
  </view>

  <!-- User Avatar Pill & Dynamic Status Clock Row -->
  <view class="user-status-row">
    <view class="user-pill">
      <view class="avatar-circle">天才</view>
      <text class="user-name">李</text>
    </view>
    
    <view class="status-clock">
      <text class="clock-time">{{timeStr}}</text>
      <view class="active-dot"></view>
      <text class="clock-date">{{dateStr}}</text>
      <view class="refresh-circle-btn" bindtap="onRefreshClick">
        <text class="refresh-arrow">↻</text>
      </view>
    </view>
  </view>

  <!-- Portfolio Asset Card (Replicating Web Design) -->
  <view class="portfolio-summary-card">
    <view class="card-columns">
      <view class="card-column-left">
        <text class="card-label">资产</text>
        <text class="card-value-large">{{totalAssetsStr}}</text>
      </view>
      <view class="card-column-right">
        <text class="card-label">今日</text>
        <text class="card-value-large-today {{todayProfit >= 0 ? 'positive' : 'negative'}}">{{todayProfitStr}}</text>
        <text class="card-pct {{todayProfit >= 0 ? 'positive' : 'negative'}}">{{todayProfitPctStr}}</text>
      </view>
    </view>
  </view>

  <!-- List Action Toolbar Row (Replicating Web Design) -->
  <view class="portfolio-action-row">
    <view class="action-left">
      <text class="items-count">{{filteredFunds.length}} 项</text>
      <text class="list-title">持仓列表</text>
    </view>
    <view class="action-right">
      <button class="btn btn-secondary customize-btn" bindtap="onCustomizeClick">自定义</button>
      <button class="btn btn-primary add-fund-btn" bindtap="showAddModal">增加基金</button>
    </view>
  </view>

  <!-- Horizontal Filter Categories Pills -->
  <scroll-view class="category-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <block wx:for="{{categories}}" wx:key="*this">
      <view class="category-pill {{activeCategory === item ? 'active' : ''}}" 
            data-category="{{item}}" 
            bindtap="onCategorySelect">
        {{item}}
      </view>
    </block>
  </scroll-view>

  <!-- 4-Column Holdings Grid Header (Replicating Web Design) -->
  <view class="holdings-table-header">
    <view class="col-head col-name" data-sort="code" bindtap="onSortChange">
      <text>基金</text>
      <text class="sort-icon" wx:if="{{sortKey === 'code'}}">{{sortOrder === 'desc' ? '▼' : '▲'}}</text>
    </view>
    <view class="col-head col-today" data-sort="todayProfit" bindtap="onSortChange">
      <text>今日</text>
      <text class="sort-icon" wx:if="{{sortKey === 'todayProfit'}}">{{sortOrder === 'desc' ? '▼' : '▲'}}</text>
    </view>
    <view class="col-head col-holding" data-sort="holdingProfit" bindtap="onSortChange">
      <text>持有</text>
      <text class="sort-icon" wx:if="{{sortKey === 'holdingProfit'}}">{{sortOrder === 'desc' ? '▼' : '▲'}}</text>
    </view>
    <view class="col-head col-amount" data-sort="amount" bindtap="onSortChange">
      <text>金额</text>
      <text class="sort-icon" wx:if="{{sortKey === 'amount'}}">{{sortOrder === 'desc' ? '▼' : '▲'}}</text>
    </view>
  </view>

  <!-- 4-Column Holdings List Sheet -->
  <view class="holdings-list-box" wx:if="{{filteredFunds.length > 0}}">
    <block wx:for="{{filteredFunds}}" wx:key="code">
      <view class="holding-row-box" data-code="{{item.code}}" bindtap="navigateToDetail">
        
        <!-- Column 1: Name and code/badge -->
        <view class="col-body col-name">
          <text class="fund-name-lbl">{{item.name}}</text>
          <view class="code-badge-row">
            <text class="estimate-badge">估算</text>
            <text class="fund-code-lbl">{{item.code}}</text>
          </view>
        </view>

        <!-- Column 2: Today stats -->
        <view class="col-body col-today">
          <text class="today-val-lbl {{item.todayProfit >= 0 ? 'positive' : 'negative'}}">{{item.todayProfitStr}}</text>
          <text class="today-pct-lbl {{item.todayProfit >= 0 ? 'positive' : 'negative'}}">{{item.todayProfitPctStr}}</text>
        </view>

        <!-- Column 3: Holding stats -->
        <view class="col-body col-holding">
          <text class="holding-profit-val {{item.holdingProfit >= 0 ? 'positive' : 'negative'}}">{{item.holdingProfitStr}}</text>
          <text class="holding-pct-lbl {{item.holdingProfit >= 0 ? 'positive' : 'negative'}}">{{item.holdingRateStr}}</text>
        </view>

        <!-- Column 4: Amount and Weight -->
        <view class="col-body col-amount">
          <text class="holding-amount-lbl">{{item.amountStr}}</text>
          <text class="holding-weight-lbl">{{item.todayProfitPctStr}}</text>
        </view>

      </view>
    </block>
  </view>

  <!-- Empty list container -->
  <view class="empty-container" wx:else>
    <view class="empty-icon">📂</view>
    <text class="empty-text">当前分类下无任何持仓，请点击右上方增加基金。</text>
  </view>

  <!-- Add Fund Drawer Modal -->
  <view class="modal-overlay" wx:if="{{showAddModal}}" bindtap="hideAddModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-title">添加新基金持仓</view>
      
      <!-- Input fund code (autocompletes names) -->
      <view class="form-group">
        <text class="form-label">基金代码 (6位数字)</text>
        <input class="form-input" 
               type="number"
               maxlength="6"
               placeholder="例如：019633" 
               placeholder-style="color:#86868b"
               value="{{newFundCode}}"
               bindinput="onInputFundCode" />
        <text class="lookup-status {{lookupSuccess ? 'lookup-success-text' : ''}}">{{lookupStatus}}</text>
      </view>

      <view class="form-group">
        <text class="form-label">基金名称</text>
        <input class="form-input" 
               placeholder="输入代码可自动识别，亦可手动修改" 
               placeholder-style="color:#86868b"
               value="{{newFundName}}"
               bindinput="onInputFundName" />
      </view>

      <view class="form-grid">
        <view class="form-group">
          <text class="form-label">持有总金额 (元)</text>
          <input class="form-input" 
                 type="digit"
                 placeholder="0.00"
                 placeholder-style="color:#86868b"
                 value="{{newFundAmount}}"
                 bindinput="onInputFundAmount" />
        </view>
        <view class="form-group">
          <text class="form-label">当前持有收益 (元)</text>
          <input class="form-input" 
                 type="digit"
                 placeholder="0.00"
                 placeholder-style="color:#86868b"
                 value="{{newFundProfit}}"
                 bindinput="onInputFundProfit" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">大类资产分类</text>
        <picker mode="selector" range="{{pickerCategories}}" value="{{categoryIndex}}" bindchange="onCategoryPickerChange">
          <view class="picker-selector">
            {{pickerCategories[categoryIndex]}}
          </view>
        </picker>
      </view>

      <view class="modal-actions-stacked">
        <button class="btn btn-primary btn-block" bindtap="submitAddFund">登记持仓</button>
        <button class="btn btn-secondary btn-block" bindtap="hideAddModal">取消</button>
      </view>
    </view>
  </view>

</view>
