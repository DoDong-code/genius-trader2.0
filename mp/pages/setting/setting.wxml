<!-- pages/setting/setting.wxml -->
<view class="container">
  
  <!-- WeChat Authorization Block -->
  <view class="user-profile-card card">
    <image class="user-avatar" src="{{userInfo.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqgA98eO8Z33ibA9ic2A1X3G1A8OticH8K0zK8zK8zK8zK8zK8zK8w/0'}}" mode="aspectFill"></image>
    <view class="user-details">
      <text class="user-nickname">{{userInfo.nickName || '未登录用户 (Guest)'}}</text>
      <text class="user-openid">隔离 OpenID: {{openid}}</text>
    </view>
    <button class="btn btn-primary login-btn" bindtap="onWechatLogin" wx:if="{{!isLoggedIn}}">授权登录</button>
  </view>

  <!-- Server & Cloud Sync Config -->
  <view class="setting-block card">
    <text class="block-title">服务网关与云同步</text>
    <text class="block-subtitle">配置服务器接口地址，或切换本地存储与微信云开发</text>
    
    <view class="form-group">
      <text class="form-label">API 接口网关地址</text>
      <input class="form-input" 
             value="{{apiBaseUrl}}" 
             bindinput="onInputApiBase" 
             placeholder="https://your-domain.com" />
    </view>
    
    <view class="sync-mode-selector">
      <view class="sync-mode-label">微信云开发数据库</view>
      <switch checked="{{useCloudDb}}" bindchange="onCloudDbChange" color="#0a84ff"></switch>
    </view>
    <text class="sync-hint-text">
      开启后，持仓与账单数据将实时备份并隔离保存在微信 CloudBase 账户数据库中。
    </text>
  </view>

  <!-- Active Account Investment Rules Manager -->
  <view class="setting-block card">
    <text class="block-title">{{activeAccountName}} 投资策略管理</text>
    <text class="block-subtitle">增加或修改账户下的核心操作指导策略</text>
    
    <view class="rule-edit-list" wx:if="{{strategy.length > 0}}">
      <block wx:for="{{strategy}}" wx:key="*this">
        <view class="rule-edit-item">
          <text class="rule-text">{{item}}</text>
          <text class="rule-delete" data-index="{{index}}" bindtap="onDeleteStrategy">✕</text>
        </view>
      </block>
    </view>

    <view class="form-group add-rule-group">
      <input class="form-input form-input-rule" 
             placeholder="新增策略方针，例如：保持现金占比15%" 
             placeholder-style="color:#636366"
             value="{{newStrategyText}}"
             bindinput="onInputNewStrategy" />
      <button class="btn btn-primary btn-add-rule" bindtap="onAddStrategy">增加</button>
    </view>
  </view>

  <!-- Account Closed Positions Recorder -->
  <view class="setting-block card">
    <text class="block-title">增补清仓退出记录</text>
    <text class="block-subtitle">登记当前账户下清仓和观察期结束退出的基金记录</text>
    
    <view class="form-group">
      <text class="form-label">已清仓基金名称</text>
      <input class="form-input" 
             placeholder="例如：天弘中证银行ETF联接C" 
             placeholder-style="color:#636366"
             value="{{closedFundName}}"
             bindinput="onInputClosedFundName" />
    </view>
    <view class="form-grid">
      <view class="form-group">
        <text class="form-label">基金代码</text>
        <input class="form-input" 
               type="number"
               maxlength="6"
               placeholder="例如：001595" 
               placeholder-style="color:#636366"
               value="{{closedFundCode}}"
               bindinput="onInputClosedFundCode" />
      </view>
      <view class="form-group">
        <text class="form-label">归退原因 (以分号隔开)</text>
        <input class="form-input" 
               placeholder="连涨一个月;估值偏高" 
               placeholder-style="color:#636366"
               value="{{closedFundReasons}}"
               bindinput="onInputClosedFundReasons" />
      </view>
    </view>
    
    <button class="btn btn-secondary btn-block" bindtap="onSubmitClosedFund">记入清仓历史</button>
  </view>

  <!-- Storage Utilities Backup / Restore / Clear -->
  <view class="setting-block card">
    <text class="block-title">数据维护工具</text>
    <text class="block-subtitle">进行持仓备份、跨设备导出导入或复位出厂设置</text>
    
    <view class="utility-actions">
      <button class="btn btn-secondary util-btn" bindtap="onCopyBackup">复制当前账户备份 JSON</button>
      <button class="btn btn-secondary util-btn" bindtap="onImportBackup">从备份字符串导入覆盖</button>
      <button class="btn btn-danger util-btn" bindtap="onResetStorage">重置所有数据为默认 Mock</button>
    </view>
  </view>
</view>
