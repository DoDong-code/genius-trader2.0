/* pages/setting/setting.wxss */

/* User profile card */
.user-profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx;
  margin-top: 32rpx;
  margin-bottom: 28rpx;
  gap: 24rpx;
  background: linear-gradient(135deg, #1c1c1e 0%, #151517 100%);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background-color: var(--card-dark-secondary);
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-nickname {
  font-size: 30rpx;
  font-weight: 750;
  color: #ffffff;
}

.user-openid {
  font-size: 18rpx;
  color: var(--text-secondary);
  font-family: monospace;
  margin-top: 6rpx;
  word-break: break-all;
}

.login-btn {
  font-size: 22rpx !important;
  padding: 10rpx 24rpx !important;
  border-radius: var(--border-radius-sm);
  margin-left: auto;
}

/* Setting Card Block */
.setting-block {
  padding: 36rpx !important;
  margin-bottom: 28rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 750;
  color: #ffffff;
  display: block;
}

.block-subtitle {
  font-size: 20rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 6rpx;
  margin-bottom: 32rpx;
}

/* Sync Switch */
.sync-mode-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--border-color-faint);
}

.sync-mode-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.sync-hint-text {
  font-size: 18rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-top: 12rpx;
  display: block;
}

/* Rules Manager list styling */
.rule-edit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.rule-edit-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.03);
  padding: 20rpx 24rpx;
  border-radius: var(--border-radius-sm);
  border: 1px solid var(--border-color-faint);
}

.rule-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  flex: 1;
  line-height: 1.4;
  padding-right: 18rpx;
}

.rule-delete {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-secondary);
  padding: 8rpx 12rpx;
  line-height: 1;
  transition: color 0.1s ease;
}

.rule-delete:active {
  color: var(--brand-red);
}

.add-rule-group {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 0;
  align-items: center;
}

.form-input-rule {
  flex: 1;
}

.btn-add-rule {
  font-size: 24rpx !important;
  padding: 16rpx 28rpx !important;
  height: 80rpx;
  margin: 0 !important;
}

/* Utilities maintenance box */
.utility-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.util-btn {
  width: 100% !important;
  font-size: 24rpx !important;
  padding: 20rpx 0 !important;
}
