<!-- pages/index/index.wxml -->
<view class="container">
  
  <!-- Web-style Unified Navigation Header Bar -->
  <view class="web-header">
    <view class="brand-pill">Genius trader</view>
    <view class="header-nav">
      <view class="nav-item active">总览</view>
      <view class="nav-item" bindtap="navigateToPortfolio">持仓</view>
    </view>
  </view>

  <!-- User Avatar Pill & Dynamic Status Clock Row -->
  <view class="user-status-row">
    <view class="user-pill">
      <view class="avatar-circle">天才</view>
      <text class="user-name">李</text>
    </view>
    
    <view class="status-clock">
      <text class="clock-time">{{timeStr}}</text>
      <view class="active-dot"></view>
      <text class="clock-date">{{dateStr}}</text>
      <view class="refresh-circle-btn" bindtap="onRefreshClick">
        <text class="refresh-arrow">↻</text>
      </view>
    </view>
  </view>

  <!-- Total Account Summary Dashboard Card (Replicating Web Design) -->
  <view class="dashboard-summary-card" bindtap="navigateToPortfolio">
    <view class="card-columns">
      <view class="card-column-left">
        <text class="card-label">资产</text>
        <text class="card-value-large">{{totalAssetsStr}}</text>
      </view>
      <view class="card-column-right">
        <text class="card-label">今日</text>
        <text class="card-value-large-today {{todayProfit >= 0 ? 'positive' : 'negative'}}">{{todayProfitStr}}</text>
        <text class="card-pct {{todayProfit >= 0 ? 'positive' : 'negative'}}">{{todayProfitPctStr}}</text>
      </view>
    </view>

    <!-- Additional Info in Grid -->
    <view class="card-secondary-grid">
      <view class="secondary-item">
        <text class="secondary-label">当前账户</text>
        <text class="secondary-value">{{activeAccountName}}</text>
      </view>
      <view class="secondary-item align-right">
        <text class="secondary-label">累计持有收益</text>
        <text class="secondary-value {{totalProfit >= 0 ? 'positive' : 'negative'}}">{{totalProfitStr}} ({{totalProfitPctStr}})</text>
      </view>
    </view>
    
    <!-- Footer chevron link -->
    <view class="card-footer-tip">
      <text>点击进入持仓查看明细</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- Accounts List Header Row -->
  <view class="section-title-row">
    <text class="section-title">我的配置账户</text>
    <view class="section-actions-row">
      <text class="section-count">{{accountList.length}} 个账户</text>
      <view class="header-actions">
        <button class="btn btn-secondary edit-btn" bindtap="toggleEdit">
          {{isEditing ? '完成' : '编辑'}}
        </button>
        <button class="btn btn-primary add-btn" bindtap="showAddModal" wx:if="{{!isEditing}}">
          + 账户
        </button>
      </view>
    </view>
  </view>

  <!-- Accounts Vertical List -->
  <view class="accounts-list">
    <block wx:for="{{accountList}}" wx:key="name">
      <view class="account-item-wrapper {{activeAccountName === item.name ? 'active-border' : ''}} {{isEditing ? 'editing-item' : ''}}" 
            data-name="{{item.name}}" 
            bindtap="onAccountClick">
        
        <!-- Selection Checkbox inside Edit mode -->
        <view class="checkbox-container" wx:if="{{isEditing}}" data-name="{{item.name}}" catchtap="onCheckboxClick">
          <view class="custom-checkbox {{selectedAccounts[item.name] ? 'checked' : ''}}"></view>
        </view>

        <!-- Account Core Specs -->
        <view class="account-item-body">
          <view class="account-meta-left">
            <view class="account-name-row">
              <text class="account-name">{{item.name}}</text>
              <view class="active-badge" wx:if="{{activeAccountName === item.name && !isEditing}}">当前</view>
            </view>
            <text class="account-fund-count">{{item.count}} 笔基金持仓</text>
          </view>
          
          <view class="account-meta-right" wx:if="{{!isEditing}}">
            <text class="account-total">{{item.totalStr}}</text>
            <text class="account-today {{item.todayProfit >= 0 ? 'positive' : 'negative'}}">{{item.todayProfitStr}}</text>
          </view>
          <view class="account-chevron" wx:else>
            <text class="arrow">›</text>
          </view>
        </view>

      </view>
    </block>
  </view>

  <!-- Editing Sticky Delete Footer -->
  <view class="edit-footer-bar" wx:if="{{isEditing && hasSelections}}">
    <view class="selected-summary">已选择 {{selectedCount}} 个账户</view>
    <button class="btn btn-danger delete-selected-btn" bindtap="deleteSelected">确认删除选中</button>
  </view>

  <!-- Create Account Drawer Modal -->
  <view class="modal-overlay" wx:if="{{showAddModal}}" bindtap="hideAddModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-title">创建新配置账户</view>
      
      <view class="form-group">
        <text class="form-label">账户名称</text>
        <input class="form-input" 
               placeholder="例如：指数增强账户、养老金组合" 
               placeholder-style="color:#86868b"
               value="{{newAccountName}}"
               bindinput="onInputAccountName"
               focus="{{showAddModal}}" />
      </view>
      
      <view class="modal-actions-stacked">
        <button class="btn btn-primary btn-block" bindtap="submitAddAccount">立即创建账户</button>
        <button class="btn btn-secondary btn-block" bindtap="hideAddModal">取消</button>
      </view>
    </view>
  </view>

</view>
