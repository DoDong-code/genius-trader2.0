/* pages/index/index.wxss */

/* Unified Web-Style Brand Navigation Header */
.web-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 20rpx;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.brand-pill {
  background-color: #1d1d1f;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  letter-spacing: -0.5rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-nav {
  display: flex;
  gap: 8rpx;
}

.nav-item {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #86868b;
  transition: all 0.15s ease;
}

.nav-item.active {
  background-color: #e8e8ed;
  color: #1d1d1f;
  font-weight: 700;
}

/* User & Clock Ticking Row */
.user-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.user-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: #e8e8ed;
  padding: 6rpx 18rpx 6rpx 8rpx;
  border-radius: 999rpx;
}

.avatar-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #1d1d1f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1d1d1f;
}

.status-clock {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.clock-time {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d1d1f;
  font-family: monospace;
}

.active-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #34a853;
  box-shadow: 0 0 8rpx rgba(52, 168, 83, 0.4);
}

.clock-date {
  font-size: 22rpx;
  color: #86868b;
}

.refresh-circle-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.08);
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
  transition: transform 0.15s ease;
}

.refresh-circle-btn:active {
  transform: scale(0.92);
  background-color: #f5f5f7;
}

.refresh-arrow {
  font-size: 24rpx;
  color: #1d1d1f;
  font-weight: bold;
}

/* Executive Dashboard Summary Card */
.dashboard-summary-card {
  background-color: #ffffff;
  border-radius: var(--border-radius-lg);
  padding: 38rpx;
  border: 1px solid var(--border-color);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
}

.card-columns {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
}

.card-column-left {
  display: flex;
  flex-direction: column;
}

.card-column-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.card-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.card-value-large {
  font-size: 52rpx;
  font-weight: 850;
  color: var(--text-primary);
  letter-spacing: -1.5rpx;
  font-variant-numeric: tabular-nums;
}

.card-value-large-today {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.card-pct {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* Secondary statistics row */
.card-secondary-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.secondary-item {
  display: flex;
  flex-direction: column;
}

.secondary-label {
  font-size: 18rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.secondary-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.align-right {
  align-items: flex-end;
  text-align: right;
}

/* Card footer details action */
.card-footer-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: var(--text-secondary);
  background-color: #f5f5f7;
  padding: 12rpx 20rpx;
  border-radius: var(--border-radius-sm);
}

.card-footer-tip .arrow {
  font-size: 24rpx;
  font-weight: bold;
}

/* Section Headings */
.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 750;
  color: var(--text-primary);
}

.section-actions-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-count {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  gap: 10rpx;
}

.edit-btn, .add-btn {
  font-size: 20rpx !important;
  padding: 10rpx 24rpx !important;
  min-height: 48rpx !important;
}

/* Accounts vertical list style */
.accounts-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 40rpx;
}

.account-item-wrapper {
  background-color: var(--card-dark);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-md);
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
}

.account-item-wrapper:active {
  background-color: rgba(0, 0, 0, 0.02);
}

.active-border {
  border-color: rgba(0, 113, 227, 0.35);
  background: linear-gradient(90deg, rgba(0, 113, 227, 0.02) 0%, rgba(255, 255, 255, 1) 100%);
}

.checkbox-container {
  padding-right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2px solid var(--text-secondary);
  position: relative;
  transition: all 0.15s ease;
}

.custom-checkbox.checked {
  border-color: var(--brand-red);
  background-color: var(--brand-red);
}

.custom-checkbox.checked::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 14rpx;
  width: 8rpx;
  height: 16rpx;
  border: solid #ffffff;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

.account-item-body {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.account-meta-left {
  display: flex;
  flex-direction: column;
}

.account-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.account-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.active-badge {
  font-size: 16rpx;
  font-weight: 700;
  color: var(--brand-blue);
  background-color: rgba(0, 113, 227, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.account-fund-count {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.account-meta-right {
  text-align: right;
  display: flex;
  flex-direction: column;
}

.account-total {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.account-today {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.account-chevron {
  font-size: 34rpx;
  color: var(--text-secondary);
}

/* Editing sticky delete footer bar style */
.edit-footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(0, 0, 0, 0.05);
  padding: 28rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.selected-summary {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.delete-selected-btn {
  font-size: 24rpx !important;
  padding: 16rpx 32rpx !important;
  margin: 0 !important;
}

/* Modals layout extension */
.modal-actions-stacked {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-block {
  width: 100% !important;
}
