/* pages/fund/fund.wxss */

.fund-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 40rpx 0 24rpx;
}

.header-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.fund-tags {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 8rpx;
}

.tag-category {
  font-size: 16rpx;
  font-weight: 700;
  color: #ffffff;
  background-color: var(--brand-blue);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  text-transform: uppercase;
}

.tag-code {
  font-size: 18rpx;
  font-family: monospace;
  color: var(--text-secondary);
  background-color: rgba(255, 255, 255, 0.05);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.fund-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.3;
}

.edit-fund-btn {
  font-size: 24rpx !important;
  padding: 10rpx 28rpx !important;
  margin-left: 20rpx;
}

/* Big KPIs Metrics Card */
.detail-kpis-card {
  background: linear-gradient(135deg, #1c1c1e 0%, #151517 100%);
  border-radius: var(--border-radius-lg);
  padding: 36rpx;
  border: 1px solid var(--border-color);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  margin-bottom: 28rpx;
}

.detail-kpi-main {
  text-align: center;
  padding-bottom: 28rpx;
  border-bottom: 1px solid var(--border-color-faint);
  margin-bottom: 24rpx;
}

.detail-kpi-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  display: block;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.detail-kpi-val {
  font-size: 68rpx;
  font-weight: 800;
  display: block;
  margin: 6rpx 0;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.detail-kpi-pct {
  font-size: 22rpx;
  font-weight: 600;
}

.detail-kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  text-align: center;
}

.detail-kpi-sub:first-child {
  border-right: 1px solid var(--border-color-faint);
}

.detail-sub-val {
  font-size: 32rpx;
  font-weight: 750;
  margin-top: 6rpx;
  display: block;
  font-variant-numeric: tabular-nums;
}

.detail-sub-pct {
  font-size: 18rpx;
  font-weight: 600;
  margin-top: 4rpx;
  display: block;
}

/* Canvas Vector Chart styling */
.chart-section {
  padding: 28rpx !important;
  margin-bottom: 28rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.chart-stat {
  font-size: 18rpx;
  color: var(--text-secondary);
  font-family: monospace;
}

.canvas-wrapper {
  position: relative;
  width: 100%;
  height: 320rpx;
  background-color: rgba(255, 255, 255, 0.01);
  border-radius: var(--border-radius-sm);
  margin-bottom: 20rpx;
}

.nav-chart {
  width: 100%;
  height: 320rpx;
  display: block;
}

.chart-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(28, 28, 30, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--border-radius-sm);
  z-index: 10;
  gap: 16rpx;
}

.chart-loading text {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  border-left-color: var(--brand-blue);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Range Select Tabs styling */
.range-tabs {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.04);
  padding: 6rpx;
  border-radius: 999rpx;
  border: 1px solid var(--border-color-faint);
}

.range-tab {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
  padding: 10rpx 0;
  border-radius: 999rpx;
  transition: all 0.15s ease;
}

.range-tab.active {
  background-color: var(--card-dark-secondary);
  color: var(--brand-blue);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

/* Detailed Ledger sub-tab selectors */
.detail-ledger-tabs {
  display: flex;
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 16rpx;
  padding: 0 12rpx;
}

.ledger-tab {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  padding: 20rpx 24rpx;
  position: relative;
  transition: all 0.15s ease;
}

.ledger-tab.active {
  color: #ffffff;
}

.ledger-tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 24rpx;
  right: 24rpx;
  height: 4rpx;
  background-color: var(--brand-blue);
  border-radius: 2rpx;
}

/* Ledger Content Lists */
.ledger-content {
  background-color: var(--card-dark);
  border-radius: var(--border-radius-md);
  border: 1px solid var(--border-color);
  overflow: hidden;
  margin-bottom: 40rpx;
}

.list-item-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1px solid var(--border-color-faint);
  background-color: rgba(255, 255, 255, 0.01);
}

.list-item-header text {
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.list-item-header text.right {
  text-align: right;
}

.ledger-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1px solid var(--border-color-faint);
}

.ledger-row:last-child {
  border-bottom: 0;
}

.ledger-row-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ledger-row-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.bold-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.sub-text {
  font-size: 18rpx;
  font-family: monospace;
  color: var(--text-secondary);
}

.weight-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-blue);
  font-variant-numeric: tabular-nums;
}

.amount-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.fee-text {
  font-size: 16rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* Ledger Content performance specific */
.performance-list-view .ledger-row {
  padding: 28rpx;
}

/* Form modifications inside modal */
.border-separator {
  height: 1px;
  background-color: var(--border-color-faint);
  margin: 32rpx 0;
}

.form-subsection-title {
  font-size: 24rpx;
  font-weight: 750;
  color: #ffffff;
  margin-bottom: 18rpx;
  display: block;
}

.tx-type-selector {
  display: flex;
  gap: 16rpx;
  background-color: rgba(255, 255, 255, 0.04);
  padding: 6rpx;
  border-radius: var(--border-radius-sm);
  border: 1px solid var(--border-color-faint);
}

.tx-type-option {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  padding: 14rpx 0;
  border-radius: var(--border-radius-sm);
  transition: all 0.1s ease;
}

.tx-type-option.active-buy {
  background-color: rgba(255, 69, 58, 0.15);
  color: var(--brand-red);
  border: 1px solid rgba(255, 69, 58, 0.25);
}

.tx-type-option.active-sell {
  background-color: rgba(48, 209, 88, 0.15);
  color: var(--brand-green);
  border: 1px solid rgba(48, 209, 88, 0.25);
}
