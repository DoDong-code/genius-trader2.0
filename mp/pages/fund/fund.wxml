<!-- pages/fund/fund.wxml -->
<view class="container">
  
  <!-- Page Header -->
  <view class="fund-detail-header">
    <view class="header-main">
      <view class="fund-tags">
        <text class="tag-category">{{fund.category}}</text>
        <text class="tag-code">{{fund.code}}</text>
      </view>
      <text class="fund-title">{{fund.name}}</text>
    </view>
    <button class="btn btn-secondary edit-fund-btn" bindtap="showEditModal">编辑</button>
  </view>

  <!-- Big KPIs Metrics Grid -->
  <view class="detail-kpis-card">
    <view class="detail-kpi-main">
      <text class="detail-kpi-label">今日估算收益</text>
      <text class="detail-kpi-val {{fund.todayProfit >= 0 ? 'positive' : 'negative'}}">{{fund.todayProfitStr}}</text>
      <text class="detail-kpi-pct {{fund.todayProfit >= 0 ? 'positive' : 'negative'}}">估值今日 {{fund.todayProfitPctStr}}</text>
    </view>
    
    <view class="detail-kpi-grid">
      <view class="detail-kpi-sub">
        <text class="detail-kpi-label">持有收益</text>
        <text class="detail-sub-val {{fund.holdingProfit >= 0 ? 'positive' : 'negative'}}">{{fund.holdingProfitStr}}</text>
        <text class="detail-sub-pct {{fund.holdingProfit >= 0 ? 'positive' : 'negative'}}">{{fund.holdingRateStr}}</text>
      </view>
      <view class="detail-kpi-sub">
        <text class="detail-kpi-label">持有总金额</text>
        <text class="detail-sub-val">{{fund.amountStr}}</text>
        <text class="detail-sub-pct">占比 {{accountWeightStr}}</text>
      </view>
    </view>
  </view>

  <!-- Dynamic Vector Line Chart Section -->
  <view class="chart-section card">
    <view class="chart-header">
      <text class="chart-title">历史估算净值走势</text>
      <text class="chart-stat" wx:if="{{chartMinMaxStr}}">{{chartMinMaxStr}}</text>
    </view>
    
    <!-- Vector Canvas -->
    <view class="canvas-wrapper">
      <view class="chart-loading" wx:if="{{isLoadingChart}}">
        <view class="spinner"></view>
        <text>正在加载历史净值数据...</text>
      </view>
      <canvas type="2d" id="chartCanvas" class="nav-chart"></canvas>
    </view>

    <!-- Range Select Tabs -->
    <view class="range-tabs">
      <block wx:for="{{ranges}}" wx:key="key">
        <view class="range-tab {{activeRange === item.key ? 'active' : ''}}" 
              data-range="{{item.key}}" 
              bindtap="onRangeSelect">
          {{item.label}}
        </view>
      </block>
    </view>
  </view>

  <!-- Detailed Ledger Tabs (Sub-tabs) -->
  <view class="detail-ledger-tabs">
    <view class="ledger-tab {{activeTab === 'holdings' ? 'active' : ''}}" data-tab="holdings" bindtap="onTabSelect">
      持仓明细
    </view>
    <view class="ledger-tab {{activeTab === 'transactions' ? 'active' : ''}}" data-tab="transactions" bindtap="onTabSelect">
      交易记录
    </view>
    <view class="ledger-tab {{activeTab === 'performance' ? 'active' : ''}}" data-tab="performance" bindtap="onTabSelect">
      历史业绩
    </view>
  </view>

  <!-- Tab Content: Holdings Breakdown -->
  <view class="ledger-content" wx:if="{{activeTab === 'holdings'}}">
    <view class="holdings-list-view" wx:if="{{majorHoldings.length > 0}}">
      <view class="list-item-header">
        <text>主要成份(股/债/黄金)</text>
        <text class="right">权重占比</text>
      </view>
      <block wx:for="{{majorHoldings}}" wx:key="stock_code">
        <view class="ledger-row">
          <view class="ledger-row-left">
            <text class="bold-text">{{item.stock_name}}</text>
            <text class="sub-text">{{item.stock_code}}</text>
          </view>
          <view class="ledger-row-right">
            <text class="weight-text">{{item.weightPctStr}}</text>
          </view>
        </view>
      </block>
    </view>
    <view class="empty-container" wx:else>
      <view class="empty-icon">📁</view>
      <text class="empty-text">该基金无主要成份股公开披露</text>
    </view>
  </view>

  <!-- Tab Content: Transactions History -->
  <view class="ledger-content" wx:if="{{activeTab === 'transactions'}}">
    <view class="transactions-list-view" wx:if="{{transactions.length > 0}}">
      <view class="list-item-header">
        <text>交易类型与时间</text>
        <text class="right">交易金额</text>
      </view>
      <block wx:for="{{transactions}}" wx:key="index">
        <view class="ledger-row">
          <view class="ledger-row-left">
            <text class="bold-text {{item.type === 'buy' ? 'positive' : 'negative'}}">{{item.typeStr}}</text>
            <text class="sub-text">{{item.date}}</text>
          </view>
          <view class="ledger-row-right">
            <text class="amount-text">{{item.amountStr}}</text>
            <text class="fee-text" wx:if="{{item.fee > 0}}">手续费 ¥{{item.fee}}</text>
          </view>
        </view>
      </block>
    </view>
    <view class="empty-container" wx:else>
      <view class="empty-icon">📝</view>
      <text class="empty-text">暂无任何交易记录</text>
    </view>
  </view>

  <!-- Tab Content: Performance Summary -->
  <view class="ledger-content" wx:if="{{activeTab === 'performance'}}">
    <view class="performance-list-view">
      <view class="ledger-row">
        <view class="ledger-row-left"><text class="bold-text">近1月收益率</text></view>
        <view class="ledger-row-right"><text class="weight-text {{perf.month1 >= 0 ? 'positive' : 'negative'}}">{{perf.month1Str}}</text></view>
      </view>
      <view class="ledger-row">
        <view class="ledger-row-left"><text class="bold-text">近3月收益率</text></view>
        <view class="ledger-row-right"><text class="weight-text {{perf.month3 >= 0 ? 'positive' : 'negative'}}">{{perf.month3Str}}</text></view>
      </view>
      <view class="ledger-row">
        <view class="ledger-row-left"><text class="bold-text">近6月收益率</text></view>
        <view class="ledger-row-right"><text class="weight-text {{perf.month6 >= 0 ? 'positive' : 'negative'}}">{{perf.month6Str}}</text></view>
      </view>
      <view class="ledger-row">
        <view class="ledger-row-left"><text class="bold-text">今年以来收益率</text></view>
        <view class="ledger-row-right"><text class="weight-text {{perf.yearYtd >= 0 ? 'positive' : 'negative'}}">{{perf.yearYtdStr}}</text></view>
      </view>
    </view>
  </view>

  <!-- Edit Holding & Transaction Recorder Modal -->
  <view class="modal-overlay" wx:if="{{showEditModal}}" bindtap="hideEditModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-title">修改持仓 / 记账</view>
      
      <!-- Position Base Parameters -->
      <view class="form-grid">
        <view class="form-group">
          <text class="form-label">当前持有金额 (元)</text>
          <input class="form-input" 
                 type="digit"
                 value="{{editAmount}}"
                 bindinput="onInputEditAmount" />
        </view>
        <view class="form-group">
          <text class="form-label">当前持有收益 (元)</text>
          <input class="form-input" 
                 type="digit"
                 value="{{editProfit}}"
                 bindinput="onInputEditProfit" />
        </view>
      </view>

      <view class="border-separator"></view>
      
      <!-- New Transaction Entry -->
      <text class="form-subsection-title">登记一笔新交易</text>
      
      <view class="form-group">
        <text class="form-label">交易类型</text>
        <view class="tx-type-selector">
          <view class="tx-type-option {{newTxType === 'buy' ? 'active-buy' : ''}}" data-type="buy" bindtap="onSelectTxType">买入</view>
          <view class="tx-type-option {{newTxType === 'sell' ? 'active-sell' : ''}}" data-type="sell" bindtap="onSelectTxType">卖出</view>
        </view>
      </view>

      <view class="form-grid">
        <view class="form-group">
          <text class="form-label">交易金额 (元)</text>
          <input class="form-input" 
                 type="digit"
                 placeholder="0.00"
                 placeholder-style="color:#636366"
                 value="{{newTxAmount}}"
                 bindinput="onInputNewTxAmount" />
        </view>
        <view class="form-group">
          <text class="form-label">日期</text>
          <picker mode="date" value="{{newTxDate}}" bindchange="onTxDateChange">
            <view class="picker-selector">{{newTxDate}}</view>
          </picker>
        </view>
      </view>

      <view class="modal-actions-stacked">
        <button class="btn btn-primary btn-block" bindtap="submitEditHolding">保存修改并录入</button>
        <button class="btn btn-secondary btn-block" bindtap="hideEditModal">取消</button>
        <button class="btn btn-danger btn-block" bindtap="deletePosition">删除此基金持仓</button>
      </view>
    </view>
  </view>
</view>
